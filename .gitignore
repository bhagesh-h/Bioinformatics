# Figures and output written by the modules at run time.
results/

# Datasets pulled by tools/fetch_data.py. Provenance is recorded per dataset
# but the data itself does not belong in the repository.
data/raw/*
!data/raw/.gitkeep
*.png
!docs/**/*.png

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
# renv and RStudio project files. This project's R environment is defined by
# env/r-packages.R and docker/Dockerfile.r, so the renv scaffolding that
# RStudio creates is left on disk but kept out of the repository.
statsR/renv/
statsR/renv.lock
statsR/.Rprofile
statsR/*.Rproj

# Editors and operating systems
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
